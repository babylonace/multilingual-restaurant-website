{
  "name": "multilingual-restaurant-website",
  "version": "1.0.0",
  "description": "Multilingual restaurant website: a static site pre-rendered in 10 languages (incl. right-to-left Arabic), built for Inkawasi, a Peruvian restaurant in Ferrol.",
  "scripts": {
    "tokens": "tsx scripts/tokens.ts",
    "dev": "npm run tokens && astro dev",
    "build": "npm run tokens && astro build",
    "preview": "astro preview",
    "typecheck": "npm run tokens && astro sync && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "optimize:images": "tsx scripts/optimize-images.ts",
    "build:og": "tsx scripts/og-image.ts",
    "lighthouse": "npx --yes @lhci/cli@0.15.1 autorun",
    "build:favicon": "tsx scripts/favicon.ts",
    "instagram": "tsx scripts/instagram.ts"
  },
  "type": "module",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "astro": "7.4.5",
    "country-flag-icons": "^1.6.20",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "simple-icons": "^16.36.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  }
}
